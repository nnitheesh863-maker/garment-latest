{
  "name": "garment-factory",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Based Garment Production Optimization System",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix frontend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "seed:demo": "npm --prefix backend run seed:demo",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "test:e2e": "playwright test",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
